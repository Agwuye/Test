body{
  background-color: #F7F4EC;
  color:#14152B;
  margin:0;
  padding:0;
  font-size: 17px;
  font-weight: 250;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin:15px;
}
.hero-text,.features {
  margin:15px;
}

h1,h2 {
  text-transform: capitalize;
}
a{
  text-decoration: none;
}

#gs , #osx{
  color:#F7F4EC;
  background-color: #14152B;
  padding: 10px 20px 10px 20px;
  border-radius: 30px;
}

.links{
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin: 15px;
}

#os{
  color:#F7F4EC;
  background-color: #F4A340;
  padding: 10px 20px 10px 20px;
  border-radius: 30px;
}

#ss{
  border:1px solid #14152B;
  padding: 10px 20px 10px 20px;
  border-radius: 30px;
  color:#14152B;
}

.image{
  text-align: center;
  margin-top: -10px;
}
img{
 border-radius:15px;
 margin-bottom: 5px;
}

.lists{
  border:1px solid #14152B;
  background-color:#14152B;
  color:#F7F4EC;
}

#ul {
  list-style: none;
  padding-left: 5px;
  padding-top: 20px;
  margin-top: 20px;
}

#ul li {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 40px;
}

#ul li::before {
  content: "";
  width: 18px;
  height: 18px;
  background-image: url('sun_bullet.svg');
  background-size: contain;
  background-repeat: no-repeat;
  flex-shrink: 0;
}

.features-a,.features-b,.features-c{
  border:1px solid #14152B;
  padding: 30px;
}
.features-a,.features-b{
  border-bottom: none;
}

.features-2 {
  border-collapse: collapse;
  margin: 20px;
  margin-bottom: 100px;
}

.features{
  margin-top: 100px;
}
#f1,#f2,#f3,#t0,#t1,#t2,#t3,#t4{
  color:#F4A340 ;
}

.time {
  border:1px solid #14152B;
  background-color:#14152B;
  color:#F7F4EC;
}

.time-text-main1,.time-text-main2 {
  margin:20px;
}
.time-text-main1{
  margin-top: 100px;
}

.time-text1,.time-text2,.time-text3,.time-text4{
  border-bottom:1px solid #F7F4EC;
  padding-bottom: 10px;
}

.time-text1 {
  border-top:0.5px solid #F7F4EC ;
  margin-top:50px;
  padding-top:30px ;
}

.time-text4{
  margin-bottom: 100px ;
}
.time-text1,.time-text2,.time-text3,.time-text4 {
  display: flex;
  gap: 20px;
}
.time-text1 p:first-child,
.time-text2 p:first-child,
.time-text3 p:first-child,
.time-text4 p:first-child {
  min-width: 70px;
  flex-shrink: 0;
}

.specs{
  margin-top: 50px;
  margin-bottom: 50px;
  padding: 10px 20px; 
  }


.sp0 {
  margin-top: 50px;
}

.sp0 ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sp0 li {
  display: flex;
  justify-content:space-between ;
  align-items:center ;
  border-bottom:1px solid #14152B;
  margin-bottom: 50px;
  padding-bottom: 10px;
  
}

.cta {
  background-color:#F4A340;
  padding: 30px;
  padding-top:50px ;
  padding-bottom: 50px; 
}

.cta-text {
  margin-top: 50px;
  margin-bottom: 50px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#subCTA {
  color: #F7F4EC;
}

.foot{
  color: #9A9583;
  font-size: 0.85rem;
  padding: 10px;
  text-align: center;
}

#foo {
  color:#14152B;
  font-family: cursive;
}

html {
  scroll-behavior: smooth;
  font-size: 16px ;
  font-weight: 100;
}
